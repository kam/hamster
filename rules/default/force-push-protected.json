{
  "id": "force-push-protected",
  "tool": "Bash",
  "field": "command",
  "pattern": "git\\s+push\\b(?=[^\\n;&|]*(\\s-f\\b|\\s--force\\b|\\s--force-with-lease\\b))[^\\n;&|]*\\s(\\S+\\s+)?(\\+?(main|master|production)|\\S+:(main|master|production))(\\s|$)",
  "action": "block",
  "message": "Force-push to main/master/production rewrites shared history. Push a branch and open a PR.",
  "source": "bundled",
  "created": "2026-09-07",
  "tests": [
    {"input": "git push --force origin main", "expect": "block"},
    {"input": "git push -f origin master", "expect": "block"},
    {"input": "git push origin --force-with-lease production", "expect": "block"},
    {"input": "git push --force origin HEAD:main", "expect": "block"},
    {"input": "git push --force origin feature/x", "expect": "pass"},
    {"input": "git push origin main", "expect": "pass"},
    {"input": "git push -u origin main", "expect": "pass"}
  ]
}
